{
    "mcpServers": {
        "laravel-boost": {
            "command": "php",
            "args": [
                "artisan",
                "boost:mcp"
            ],
            "tools": ["*"]
        },
        "herd": {
            "command": "cmd",
            "args": [
                "/c",
                "herd",
                "mcp"
            ],
            "tools": ["*"]
        }
    }
}
